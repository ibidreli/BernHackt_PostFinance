# Copy this file to `.env` (same directory) and fill in the real key.
# Loaded by docker-compose via `env_file:` - see docker-compose.yml.
# NEVER commit the real `.env` (it is already gitignored).

# Required when ASSISTANT_MODE=live (default) - the app fails fast at
# startup without it. Not required when ASSISTANT_MODE=cached.
OPENAI_API_KEY=sk-...

# live: calls the real OpenAI API. cached: no external calls at all, uses
# pattern-matched extraction + canned formulations for a fixed set of demo
# questions (see ASSISTANT_STATUS.md, T9) - forecast_service still computes
# real numbers either way.
ASSISTANT_MODE=live

# Model used for both LLM calls (intent extraction, answer formulation).
OPENAI_MODEL=gpt-4o-mini

# Per-call timeout in seconds. On timeout the API returns an explicit error
# to the caller (no silent template fallback) - see ASSISTANT_STATUS.md, T9.
ASSISTANT_LLM_TIMEOUT_SECONDS=8
